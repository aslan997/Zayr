[sub_resource type="GDScript" id="GDScript_TrainingDummy"]
script/source = "extends Node2D
## Test-only training target for the Veyr Edge milestone (docs/PROGRESS.md).
## Not a real enemy/interactable - flashes on hit and resets its own health
## so it can be hit repeatedly while testing. Delete when real enemies land.

@onready var health: HealthComponent = $HealthComponent
@onready var visual: Polygon2D = $Visual

var _base_color: Color


func _ready() -> void:
	_base_color = visual.color
	health.damaged.connect(_on_damaged)
	health.died.connect(_on_died)


func _on_damaged(_amount: float) -> void:
	visual.color = Color(1, 1, 1)
	get_tree().create_timer(0.08).timeout.connect(func() -> void: visual.color = _base_color)


func _on_died() -> void:
	health.current_health = health.max_health
"

